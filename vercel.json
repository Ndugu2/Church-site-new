{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/wsgi_entrypoint.py"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/backend/wsgi_entrypoint.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "backend/wsgi_entrypoint.py": {
      "runtime": "python3.11"
    }
  }
}